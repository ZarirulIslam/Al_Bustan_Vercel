# Copy this file to .env and fill in real values before running the app.
# .env is gitignored — never commit real secrets.

# PostgreSQL connection string. For local development, either:
#  - run a local Postgres (e.g. `docker run --name al-bustan-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16`)
#    then use: postgresql://postgres:postgres@localhost:5432/al_bustan
#  - or use a free hosted instance (Neon, Supabase, Railway, etc.) and
#    paste the connection string they give you here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/al_bustan"

# Used only by the Prisma CLI (db push/generate/studio/etc. — see
# prisma.config.ts), never by the running app itself. For a simple
# single-instance Postgres (e.g. local Docker) this is normally the
# same value as DATABASE_URL. If your host gives you a separate
# pooled (for DATABASE_URL) vs. direct/session-mode (for this)
# connection string — e.g. Supabase's transaction pooler vs. its
# session pooler — use the direct one here; CLI schema operations
# don't work reliably through a transaction-mode pooler.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/al_bustan"

# NextAuth — generate a random secret, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Seeds the one admin account (prisma/seed.ts). Change the password
# before running `npm run db:seed`, and again any time after via the
# database — these are placeholder credentials, not real ones.
ADMIN_EMAIL="admin@albustan-placeholder.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

# Image storage — see src/lib/storage/. "supabase" is the default and
# is required for Vercel (and recommended for the production deploy):
# a serverless/ephemeral filesystem can't reliably serve files written
# to disk at runtime. Use "local" only for local development without
# a Supabase project set up yet.
STORAGE_PROVIDER="supabase"
# Must match STORAGE_PROVIDER above — the browser reads this (public,
# non-secret) copy to decide which upload path to use for admin image
# uploads. See src/lib/uploadClient.ts.
NEXT_PUBLIC_STORAGE_PROVIDER="supabase"

# Required when STORAGE_PROVIDER="supabase":
#  1. Create a free project at https://supabase.com
#  2. In Storage, create a PUBLIC bucket (e.g. "al-bustan-uploads").
#     While creating it, set a file size limit (e.g. 5 MB) and
#     restrict allowed MIME types to image/jpeg, image/png,
#     image/webp, image/gif — this is the real, server-enforced
#     ceiling on upload size (the app's own 4MB check is just a
#     friendly first line of defense, not a security boundary).
#  3. Project Settings -> API gives you the URL, the anon/public key,
#     and the service_role key.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"
SUPABASE_STORAGE_BUCKET="al-bustan-uploads"

# Admin image uploads go directly from the browser to Supabase
# Storage (src/lib/uploadClient.ts) rather than through the server —
# this is what keeps uploads reliable on Vercel regardless of file
# count/size, since the file bytes never touch our own server's
# request-size limits. That requires these two PUBLIC values in the
# browser bundle (NEXT_PUBLIC_* variables are safe to expose — this
# is the anon key, not the secret service_role key above).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-your-anon-public-key"
